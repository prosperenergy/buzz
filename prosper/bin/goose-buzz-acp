#!/bin/zsh
set -eu

root="${BUZZ_PROSPER_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
runtime="$root/prosper/.runtime"

export XDG_CONFIG_HOME="$runtime/homes/goose/.config"
export XDG_DATA_HOME="$runtime/homes/goose/.local/share"
export CODEX_HOME="$runtime/homes/codex/.codex"
export CODEX_PATH="$runtime/npm/node_modules/.bin/codex"
export APP_SERVER_LOGS="$runtime/logs/goose-codex"
export INITIAL_AGENT_MODE="agent"
export NO_BROWSER=1
export GOOSE_PROVIDER="codex-acp"
export GOOSE_MODEL="current"
export GOOSE_MODE="approve"
export PATH="$runtime/npm/node_modules/.bin:/Users/craigstratton/.local/bin:/Users/craigstratton/.npm-global/bin:/usr/bin:/bin:/usr/sbin:/sbin"
unset OPENAI_API_KEY CODEX_API_KEY ANTHROPIC_API_KEY XAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY

exec /Users/craigstratton/.local/bin/goose acp "$@"
